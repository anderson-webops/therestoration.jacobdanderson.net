{
	"name": "back-end",
	"version": "4.0.0",
	"private": true,
	"packageManager": "npm@12.0.2",
	"engines": {
		"node": ">=24.18.1 <25",
		"npm": ">=12.0.2 <13"
	},
	"description": "Stateless contact API and production web server for The Restoration",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"lint": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\" --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.5.1",
		"helmet": "^8.1.0",
		"nodemailer": "^9.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.0",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^4.1.5"
	}
}
