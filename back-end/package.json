{
	"name": "back-end",
	"version": "4.0.15",
	"private": true,
	"packageManager": "npm@12.2.1",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.1 <13"
	},
	"description": "Stateless contact API and production web server for The Restoration",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"start": "node dist/server.js",
		"clean": "node -e \"const fs=require('node:fs');for(const path of ['dist','tsconfig.tsbuildinfo'])fs.rmSync(path,{recursive:true,force:true})\"",
		"build": "npm run clean && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"lint": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" \"test/**/*.ts\" --fix"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"dotenv": "^18.0.9",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.1.0",
		"nodemailer": "^10.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.3.1",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
