{
	"name": "therestoration-monorepo",
	"type": "module",
	"version": "4.0.15",
	"private": true,
	"packageManager": "npm@12.2.1",
	"engines": {
		"node": ">=26.13.0 <27",
		"npm": ">=12.2.1 <13"
	},
	"description": "Monorepo for main page",
	"author": "Jacob Anderson",
	"license": "ISC",
	"keywords": [],
	"workspaces": [
		"front-end",
		"back-end"
	],
	"scripts": {
		"build": "npm run -w front-end build && npm run -w back-end build",
		"dev": "npm run -w front-end dev",
		"server": "npm run -w back-end server",
		"server:once": "npm run -w back-end server:once",
		"start": "npm run -w back-end start",
		"serve": "npm run -w front-end serve",
		"lint-server": "npm run -w back-end lint-fix && npm run -w back-end server",
		"lint-serve": "npm run -w front-end lint-fix && npm run -w front-end serve",
		"lint": "eslint \"scripts/**/*.mjs\" && npm run -w front-end lint && npm run -w back-end lint",
		"lint-fix": "eslint \"scripts/**/*.mjs\" --fix && npm run -w front-end lint-fix && npm run -w back-end lint-fix",
		"typecheck": "npm run -w front-end typecheck && npm run -w back-end typecheck",
		"test": "npm run -w front-end test:unit && npm run -w back-end test:unit",
		"test:e2e": "npm run -w front-end test:e2e",
		"a11y": "node scripts/a11y-smoke.mjs",
		"check:native-bindings": "node scripts/check-native-bindings.mjs",
		"test:repo": "vitest run scripts/*.test.mjs",
		"test:runtime-artifact": "python3 -B -m unittest scripts/test_runtime_artifact.py -v",
		"test:promotion": "bash scripts/test-promotion-recovery.sh",
		"package:runtime": "bash scripts/build-arm64-release.sh",
		"audit:all": "npm audit --audit-level=low",
		"audit:prod": "npm audit --omit=dev --audit-level=low",
		"deps:check": "npm outdated --workspaces --long",
		"verify:public": "node scripts/verify-public.mjs",
		"verify:deploy-assets": "node scripts/verify-deploy-assets.mjs",
		"verify:production-install": "node scripts/verify-production-install.mjs",
		"test:direct-runtime": "node scripts/direct-runtime-smoke.mjs",
		"validate": "npm run check:native-bindings && npm run lint && npm run typecheck && npm run test:repo && npm test && npm run test:runtime-artifact && npm run build && npm run verify:deploy-assets && npm run verify:site",
		"verify:site": "node scripts/verify-site.mjs"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@unocss/eslint-plugin": "^66.11.0",
		"axe-core": "^4.14.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-format": "^2.0.1",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-vue": "^10.9.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"puppeteer": "^25.16.0",
		"supertest": "^7.3.1",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	},
	"overrides": {
		"defu": "6.1.6",
		"vite": "^8.3.5",
		"vue-router": "^5.4.0",
		"qs": "6.17.1",
		"@cypress/request": {
			"uuid": "14.0.0",
			"qs": "6.17.1"
		},
		"systeminformation": "5.33.19",
		"katex": "0.18.2",
		"tinypool": "^2.1.2"
	},
	"allowScripts": {
		"cypress@16.2.1": true,
		"esbuild@0.28.2": true,
		"vue-demi@0.14.10": true,
		"fsevents": false,
		"puppeteer@25.16.0": true
	}
}
