CONTACT_FROM_EMAIL=restoration@example.com
CONTACT_TO_EMAIL=contacts@jacobdanderson.net
CONTACT_FROM_NAME=The Restoration
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_REQUIRE_TLS=true
CONTACT_SMTP_USER=restoration@example.com
CONTACT_SMTP_PASS=replace-with-a-unique-app-password

# The production container is bound to loopback and expects one trusted reverse proxy.
HOST=0.0.0.0
PORT=3007
TRUST_PROXY_HOPS=1
